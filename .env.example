# ==============================================================================
# Omarchy-Healer Multi-Agent Configuration
# Supports Laya (Primary Triage/Safety) -> Gemini -> NVIDIA NIM Fallback Chain
# ==============================================================================

# 1. Primary System-1 Triage & Safety Engine (Laya / TypeSafe)
LAYA_ENDPOINT_URL="https://your-laya-endpoint.example/v1/systemone"
LAYA_API_KEY="your_laya_api_key_here"
OMARCHY_LAYA_MODEL="laya-rl-agent"
# Set LAYA_LOCAL=1 to use the in-process laya.Router(device="cpu")
LAYA_LOCAL="0"

# 2. Fallback 1: Google Gemini API (Used for Triage fallback + LangGraph Agents)
GEMINI_API_KEY="your_gemini_api_key_here"
HEALER_GEMINI_MODEL="gemini-3.8-flash"

# 3. Fallback 2: NVIDIA NIM API (OpenAI-compatible endpoint for Triage + Agents)
NVIDIA_NIM_API_KEY="your_nvidia_nim_api_key_here"
NVIDIA_API_KEY="your_nvidia_api_key_here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
HEALER_NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# 4. Healer Policy & Thresholds
# Maximum autonomy tier to auto-execute without confirmation (0, 1, or 2)
HEALER_MAX_AUTO_TIER="1"
HEALER_RAM_WARN_PERCENT="80.0"
HEALER_RAM_CRIT_PERCENT="90.0"
