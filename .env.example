# ==============================================================================
# Omarchy-Healer Multi-Agent Configuration
# Supports NVIDIA NIM (Primary) -> Google Gemini (Fallback) Chain
# ==============================================================================

# 1. Primary Triage & Agent: NVIDIA NIM API (OpenAI-compatible endpoint)
NVIDIA_NIM_API_KEY="your_nvidia_nim_api_key_here"
NVIDIA_API_KEY="your_nvidia_api_key_here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
HEALER_NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# 2. Fallback 1: Google Gemini API (Used for Triage + Agent failover)
GEMINI_API_KEY="your_gemini_api_key_here"
HEALER_GEMINI_MODEL="gemini-3.5-flash"

# 4. Healer Policy & Thresholds
# Maximum autonomy tier to auto-execute without confirmation (0, 1, or 2)
HEALER_MAX_AUTO_TIER="1"
HEALER_RAM_WARN_PERCENT="80.0"
HEALER_RAM_CRIT_PERCENT="90.0"
